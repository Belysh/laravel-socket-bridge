{
  "name": "belysh/laravel-socket-bridge",
  "description": "Native Laravel broadcasting through a project-local NestJS Socket.IO gateway and Redis Streams.",
  "type": "library",
  "license": "MIT",
  "require": {
    "illuminate/auth": "^13.0",
    "illuminate/broadcasting": "^13.0",
    "illuminate/console": "^13.0",
    "illuminate/database": "^13.0",
    "illuminate/http": "^13.0",
    "illuminate/redis": "^13.0",
    "illuminate/routing": "^13.0",
    "illuminate/support": "^13.0",
    "php": "^8.3",
    "symfony/process": "^7.4 || ^8.0",
    "symfony/yaml": "^7.4 || ^8.0"
  },
  "require-dev": {
    "orchestra/testbench": "^11.0",
    "phpunit/phpunit": "^12.0",
    "predis/predis": "^3.0"
  },
  "autoload": {
    "psr-4": {
      "SocketBridge\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "SocketBridge\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "SocketBridge\\SocketBridgeServiceProvider"
      ]
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "homepage": "https://github.com/Belysh/laravel-socket-bridge",
  "keywords": [
    "laravel",
    "websocket",
    "socket.io",
    "nestjs",
    "redis",
    "broadcasting"
  ],
  "support": {
    "issues": "https://github.com/Belysh/laravel-socket-bridge/issues",
    "source": "https://github.com/Belysh/laravel-socket-bridge"
  },
  "archive": {
    "exclude": [
      "/.github",
      "/.test-results",
      "/tests",
      "/gateway",
      "/scripts",
      "/composer.lock",
      "/phpunit.xml",
      "/.gitignore",
      "/.gitattributes",
      "/.dockerignore",
      "/vendor",
      "/.phpunit.cache",
      "/coverage",
      "/node_modules",
      "/.env",
      "/.env.*",
      "/.DS_Store"
    ]
  }
}
